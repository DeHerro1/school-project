rules_version = '2';

// Student photos and report files are served unauthenticated (parity with
// the previous public Supabase Storage bucket) — public read, no direct
// client writes. Uploads go through the Nuxt server (Admin SDK), which
// bypasses these rules.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
