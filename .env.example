# ---- API (apps/api) ----
PORT=3001
NODE_ENV=development

# Postgres — Supabase project's connection strings.
# DATABASE_URL: pooled (pgbouncer, transaction mode) — used by Prisma Client at runtime.
# DIRECT_URL: unpooled — used by `prisma migrate` (migrations need session-level features).
# For local dev via `supabase start`, both are printed in the CLI output; DIRECT_URL is the
# "DB URL" on port 54322, DATABASE_URL is the same with `?pgbouncer=true` or the pooler port.
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@localhost:54322/postgres"

# Supabase — from `supabase start` output (local dev) or Project Settings → API (hosted).
SUPABASE_URL="http://localhost:54321"
SUPABASE_ANON_KEY="change-me-anon-key"
SUPABASE_SERVICE_ROLE_KEY="change-me-service-role-key"
# Used by the API to verify Supabase-issued JWTs locally (HS256). From
# Project Settings → API → JWT Settings. For local dev, `supabase start` prints it too.
SUPABASE_JWT_SECRET="change-me-jwt-secret"
SUPABASE_STORAGE_BUCKET="school-files"

# CORS — comma separated origins allowed to call this API. Currently unused:
# no frontend calls apps/api any more (school and schools-backoffice have
# their own backends) — kept for reference / if a frontend is reconnected.
CORS_ORIGINS="http://localhost:3000"

MAX_UPLOAD_MB=10

# ---- apps/api (currently has no caller — see CORS_ORIGINS above) ----
# Public base URL of the API used by the browser
NUXT_PUBLIC_API_BASE="http://localhost:3001"
# Safe to expose client-side — the anon key is meant for the browser (RLS/Auth-gated).
# NEVER put SUPABASE_SERVICE_ROLE_KEY behind a NUXT_PUBLIC_* var.
NUXT_PUBLIC_SUPABASE_URL="http://localhost:54321"
NUXT_PUBLIC_SUPABASE_ANON_KEY="change-me-anon-key"

# ---- apps/school (Nuxt server + Firebase) ----
# Any non-empty string works for the client SDK when talking to emulators.
# For a real Firebase project, copy these from Project Settings → General → Your apps → Web app.
NUXT_PUBLIC_FIREBASE_API_KEY="demo-key"
NUXT_PUBLIC_FIREBASE_PROJECT_ID="school-project-dev"
NUXT_PUBLIC_FIREBASE_APP_ID="demo-app-id"
FIREBASE_PROJECT_ID="school-project-dev"
FIREBASE_STORAGE_BUCKET="school-project-dev.appspot.com"
# Points Auth at the local Firebase Auth Emulator (`pnpm firebase:emulators`
# — plain Node/JS, no JVM needed). Firestore/Storage use a local, file-
# persisted, Node-only stand-in instead of their (Java-requiring) emulators
# — see apps/school/server/utils/mockFirestore.ts and localStorage.ts.
# Leave this unset (and instead set GOOGLE_APPLICATION_CREDENTIALS to a
# service-account JSON path) to point apps/school at a real Firebase project
# for all three — Auth, Firestore, and Storage.
FIREBASE_AUTH_EMULATOR_HOST="localhost:9099"
