# ---- API (apps/api) ----
PORT=3001
NODE_ENV=development

# Postgres — Supabase project's connection strings.
# DATABASE_URL: pooled (pgbouncer, transaction mode) — used by Prisma Client at runtime.
# DIRECT_URL: unpooled — used by `prisma migrate` (migrations need session-level features).
# For local dev via `supabase start`, both are printed in the CLI output; DIRECT_URL is the
# "DB URL" on port 54322, DATABASE_URL is the same with `?pgbouncer=true` or the pooler port.
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@localhost:54322/postgres"

# Supabase — from `supabase start` output (local dev) or Project Settings → API (hosted).
SUPABASE_URL="http://localhost:54321"
SUPABASE_ANON_KEY="change-me-anon-key"
SUPABASE_SERVICE_ROLE_KEY="change-me-service-role-key"
# Used by the API to verify Supabase-issued JWTs locally (HS256). From
# Project Settings → API → JWT Settings. For local dev, `supabase start` prints it too.
SUPABASE_JWT_SECRET="change-me-jwt-secret"
SUPABASE_STORAGE_BUCKET="school-files"

# CORS — comma separated origins of the two Nuxt apps
CORS_ORIGINS="http://localhost:3000,http://localhost:3002"

MAX_UPLOAD_MB=10

# ---- Frontends (apps/school, apps/parent) ----
# Public base URL of the API used by the browser
NUXT_PUBLIC_API_BASE="http://localhost:3001"
# Safe to expose client-side — the anon key is meant for the browser (RLS/Auth-gated).
# NEVER put SUPABASE_SERVICE_ROLE_KEY behind a NUXT_PUBLIC_* var.
NUXT_PUBLIC_SUPABASE_URL="http://localhost:54321"
NUXT_PUBLIC_SUPABASE_ANON_KEY="change-me-anon-key"
